{
    "compilerOptions" : {
        "target" : "es2022",
        "module" : "NodeNext",
        "moduleResolution" : "NodeNext",
        "rootDir" : "./src",
        "outDir" : "./dist",
        "strict" : true,
        "noImplicitAny" : true,
        "noUnusedLocals" : true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "skipLibCheck" : true
    }, 
    "include" : ["src"]
}